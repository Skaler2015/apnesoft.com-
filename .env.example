# SoftwareHub environment configuration
# Copy to .env and adjust. Never commit the real .env.

APP_NAME="SoftwareHub"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=change-this-to-a-long-random-string

# Shared hosting only: absolute path to the public web root (e.g. Hostinger's
# public_html) when it is separate from this app folder. Leave unset for the
# default repo layout where /public sits next to /app.
# APP_PUBLIC_DIR=/home/u246829578/public_html

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=softwarehub
DB_USER=root
DB_PASS=

# Integrations
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Automation
CRON_ENABLED=true
HTTP_USER_AGENT="SoftwareHubBot/1.0 (+https://example.com/bot)"
